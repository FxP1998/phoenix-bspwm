#!/usr/bin/env python3
"""
wallpaper-theme-sort
Sort wallpapers into folders named after popular Linux color schemes.

How it works
------------
1. ffmpeg downscales each image to 96x54 and prints raw RGB (no PIL needed).
2. Pixels are converted from sRGB to CIELAB, then clustered with k-means
   to get a compact dominant-color palette (color + weight).
3. Each image palette is turned into a hue histogram (weighted by chroma)
   and compared with the official accent palette of every theme.
   Signature colors of each theme get extra weight so that, e.g., a warm
   orange image matches Gruvbox and not Nord.
4. The best theme is always assigned. Close runner-ups (within --rel of the
   top score and above --abs) are assigned too, up to --max-themes.
   Near-grayscale images go to "Monochrome".
5. The image is MOVED into the best-match folder and COPIED into the other
   matching folders. Use --copy to keep the originals in place instead.

Requirements: python3 + ffmpeg.
"""

import argparse
import hashlib
import math
import os
import random
import shutil
import subprocess
import sys

# ---------------------------------------------------------------------------
# Theme definitions (official accent palettes)
# ---------------------------------------------------------------------------
THEMES = {
    "Catppuccin": {
        "bg": "#1e1e2e",
        "accents": ["#f5e0dc", "#f2cdcd", "#f5c2e7", "#cba6f7", "#f38ba8",
                    "#eba0ac", "#fab387", "#f9e2af", "#a6e3a1", "#94e2d5",
                    "#89dceb", "#74c7ec", "#89b4fa", "#b4befe"],
    },
    "Dracula": {
